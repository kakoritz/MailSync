# MailSync environment variables
# Copy to .env (never commit .env) or export in your shell before running.

# Required: Azure App Registration client ID
# Create at: portal.azure.com > App registrations > New registration
# Platform: Mobile and desktop applications
# Scopes: Mail.ReadWrite, offline_access
MAILSYNC_CLIENT_ID=your-azure-app-client-id-here

# Optional: override the default data directory (~/ on Android, ./ on desktop)
# The database (mailsync.db), .salt, and config file are stored here.
# MAILSYNC_DATA_DIR=/path/to/data
